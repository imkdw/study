{
  "name": "rss-wiki",
  "version": "1.0.0",
  "type": "module",
  "description": "RSS 리더에 LLM을 붙여 주제별 누적 위키를 만드는 도구",
  "bin": {
    "rss-wiki": "./src/cli.ts"
  },
  "scripts": {
